# Server Configuration
PORT=8000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SERVER_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://mongodb:27017/taskflow

# JWT Authentication
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_in_production
ACCESS_TOKEN_EXPIRY=30min
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_in_production
REFRESH_TOKEN_EXPIRY=7d

# Mailtrap / SMTP Configuration
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=your_mailtrap_username
MAILTRAP_SMTP_PASSWORD=your_mailtrap_password
